generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProductType {
  SUBSCRIPTION
  COACHING
  CONSULTING
  DIGITAL
}

enum PaymentMethod {
  STRIPE
  PAYPAL
  BANK_TRANSFER
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum CreditNoteStatus {
  ISSUED
  SENT
  CANCELLED
}

enum ContractType {
  RECURRING
  ONE_SHOT
  INSTALLMENT
}

enum BillingPeriod {
  MONTHLY
  QUARTERLY
  ANNUALLY
}

enum DepositStatus {
  PENDING
  PAID
  REFUNDED
}

enum ExpenseCategory {
  TOOLS
  MARKETING
  PAYROLL
  FREELANCER
  INFRASTRUCTURE
  LEGAL
  TRAVEL
  OFFICE
  TAXES
  OTHER
}

enum EventType {
  LIVE
  WORKSHOP
  RECORDING
  WEBINAR
}

enum RecurrenceType {
  ONE_TIME
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

enum RsvpStatus {
  YES
  NO
  MAYBE
}

model CompanySettings {
  id         String   @id @default("singleton")
  name       String   @default("")
  email      String   @default("")
  phone      String?
  website    String?
  address    String?
  city       String?
  zip        String?
  province   String?
  country    String?
  vatNumber  String?
  fiscalCode String?
  bankName   String?
  iban       String?
  bic        String?
  invoiceFooter  String?
  bankBalance    Float?
  bankBalanceAt  DateTime?
  updatedAt      DateTime @updatedAt
}

model Client {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  whatsapp     String?
  company      String?
  fiscalCode   String?
  vatNumber    String?
  address      String?
  city         String?
  zip          String?
  province     String?
  country      String?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  contracts   Contract[]
  invoices    Invoice[]
  creditNotes CreditNote[]
}

model Product {
  id          String      @id @default(cuid())
  name        String
  description String?
  type        ProductType
  basePrice   Float
  currency    String      @default("EUR")
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  contracts Contract[]
}

model Contract {
  id         String       @id @default(cuid())
  clientId   String
  productId  String
  type          ContractType
  amount        Float
  currency      String        @default("EUR")
  startDate     DateTime
  endDate       DateTime?
  billingDay    Int?
  billingPeriod BillingPeriod @default(MONTHLY)
  installments  Int?
  active        Boolean       @default(true)
  notes         String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  client   Client    @relation(fields: [clientId], references: [id])
  product  Product   @relation(fields: [productId], references: [id])
  invoices Invoice[]
  deposit  Deposit?
}

model Deposit {
  id         String        @id @default(cuid())
  contractId String        @unique
  amount     Float         @default(500)
  currency   String        @default("EUR")
  status     DepositStatus @default(PENDING)
  paidAt     DateTime?
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  contract Contract @relation(fields: [contractId], references: [id])
  payment  Payment?
}

model Invoice {
  id         String        @id @default(cuid())
  number     String        @unique
  clientId   String
  contractId String?
  amount     Float
  currency   String        @default("EUR")
  status     InvoiceStatus @default(DRAFT)
  issueDate  DateTime      @default(now())
  dueDate    DateTime
  paidAt     DateTime?
  notes      String?
  lineItems  Json
  pdfUrl     String?
  sentAt     DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  client   Client    @relation(fields: [clientId], references: [id])
  contract Contract? @relation(fields: [contractId], references: [id])
  payment  Payment?
  creditNotes CreditNote[]
}

model CreditNote {
  id     String           @id @default(cuid())
  number String           @unique
  status CreditNoteStatus @default(ISSUED)

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id])

  // Snapshot dei dati cliente al momento dell'emissione — valorizzato sia per note
  // collegate a un'Invoice esistente sia per note manuali di fatture non presenti nel gestionale.
  clientName       String
  clientCompany    String?
  clientEmail      String?
  clientVatNumber  String?
  clientFiscalCode String?
  clientAddress    String?
  clientCity       String?
  clientZip        String?
  clientProvince   String?
  clientCountry    String?

  originalInvoiceNumber String
  originalInvoiceDate   DateTime?

  amount    Float
  currency  String   @default("EUR")
  reason    String
  lineItems Json
  issueDate DateTime @default(now())
  sentAt    DateTime?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id              String        @id @default(cuid())
  invoiceId       String?       @unique
  depositId       String?       @unique
  amount          Float
  currency        String        @default("EUR")
  method          PaymentMethod
  stripePaymentId String?
  paypalOrderId   String?
  reference       String?
  paidAt          DateTime      @default(now())
  notes           String?
  createdAt       DateTime      @default(now())

  invoice Invoice? @relation(fields: [invoiceId], references: [id])
  deposit Deposit? @relation(fields: [depositId], references: [id])
}

model Expense {
  id          String          @id @default(cuid())
  date        DateTime
  category    ExpenseCategory
  description String
  amount      Float
  currency    String          @default("EUR")
  vendor      String?
  receipt     String?
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model Automation {
  id          String   @id @default(cuid())
  type        String   @unique
  active      Boolean  @default(false)
  config      Json     @default("{}")
  lastRunAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SopFolder {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#4f7deb")
  order     Int      @default(0)
  createdAt DateTime @default(now())

  sops Sop[]
}

model SopTag {
  id    String      @id @default(cuid())
  name  String      @unique
  color String      @default("#4f7deb")
  sops  SopSopTag[]
}

model SopSopTag {
  sopId String
  tagId String

  sop Sop    @relation(fields: [sopId], references: [id], onDelete: Cascade)
  tag SopTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([sopId, tagId])
}

model SopAttachment {
  id        String         @id @default(cuid())
  sopId     String
  type      AttachmentType
  name      String
  url       String
  size      Int?
  createdAt DateTime       @default(now())

  sop Sop @relation(fields: [sopId], references: [id], onDelete: Cascade)
}

model Sop {
  id        String   @id @default(cuid())
  folderId  String?
  title     String
  content   Json     @default("{}")
  roles     String[]
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  folder      SopFolder?      @relation(fields: [folderId], references: [id])
  tags        SopSopTag[]
  attachments SopAttachment[]
}

model Tag {
  id         String           @id @default(cuid())
  name       String           @unique
  color      String           @default("#4f7deb")
  createdAt  DateTime         @default(now())

  members    TeamMemberTag[]
  categories CourseCategoryTag[]
}

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      String?
  avatarUrl String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags      TeamMemberTag[]
  progress  LessonProgress[]
  rsvps     EventRsvp[]
}

model TeamMemberTag {
  memberId String
  tagId    String

  member TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  tag    Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([memberId, tagId])
}

model CourseCategory {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#4f7deb")
  order     Int      @default(0)
  createdAt DateTime @default(now())

  requiredTags CourseCategoryTag[]
  courses      Course[]
}

model CourseCategoryTag {
  categoryId String
  tagId      String

  category CourseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tag      Tag            @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([categoryId, tagId])
}

model Course {
  id          String   @id @default(cuid())
  categoryId  String
  title       String
  description String?
  coverImage  String?
  published   Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category CourseCategory @relation(fields: [categoryId], references: [id])
  modules  Module[]
}

enum AttachmentType {
  LINK
  FILE
}

model Module {
  id        String   @id @default(cuid())
  courseId  String
  parentId  String?
  title     String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  parent    Module?  @relation("ModuleChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  Module[] @relation("ModuleChildren")
  lessons   Lesson[]
}

model Lesson {
  id        String   @id @default(cuid())
  moduleId  String
  title     String
  videoUrl  String?
  content   String?
  duration  Int?
  order     Int      @default(0)
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  module      Module             @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress    LessonProgress[]
  attachments LessonAttachment[]
}

model LessonAttachment {
  id        String         @id @default(cuid())
  lessonId  String
  type      AttachmentType
  name      String
  url       String
  size      Int?
  createdAt DateTime       @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

model LessonProgress {
  memberId    String
  lessonId    String
  completedAt DateTime @default(now())

  member TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  lesson Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([memberId, lessonId])
}

model Event {
  id                 String         @id @default(cuid())
  title              String
  description        String?
  type               EventType
  date               DateTime
  endDate            DateTime?
  location           String?
  meetUrl            String?
  published          Boolean        @default(false)
  recurrence         RecurrenceType @default(ONE_TIME)
  recurrenceInterval Int?
  recurrenceEndDate  DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  rsvps EventRsvp[]
}

model EventRsvp {
  memberId String
  eventId  String
  status   RsvpStatus @default(YES)

  member TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  event  Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([memberId, eventId])
}

// ── Access control ────────────────────────────────────────────────────────────

enum ObjectivePeriod {
  Q1
  Q2
  Q3
  Q4
  ANNUAL
  CUSTOM
  M1
  M2
  M3
  M4
  M5
  M6
  M7
  M8
  M9
  M10
  M11
  M12
}

enum KRType {
  METRIC
  MILESTONE
}

enum KRDataSource {
  INVOICES_AMOUNT
  CLIENT_COUNT
  EXPENSES_AMOUNT
  CONTRACT_COUNT
}

model Objective {
  id          String          @id @default(cuid())
  title       String
  description String?
  emoji       String          @default("🎯")
  color       String          @default("#4f7deb")
  period      ObjectivePeriod
  year        Int
  startDate   DateTime?
  endDate     DateTime?
  ownerId     String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  keyResults KeyResult[]
  checkIns   CheckIn[]
}

model KeyResult {
  id          String        @id @default(cuid())
  objectiveId String
  title       String
  type        KRType        @default(METRIC)
  target      Float?
  current     Float?        @default(0)
  unit        String?
  dataSource  KRDataSource?
  completed   Boolean       @default(false)
  dueDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  objective Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
}

model CheckIn {
  id          String   @id @default(cuid())
  objectiveId String
  note        String
  createdAt   DateTime @default(now())

  objective Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
}

enum AppSection {
  DASHBOARD
  INVOICES
  CREDIT_NOTES
  CLIENTS
  EXPENSES
  CONTRACTS
  PRODUCTS
  PAYMENTS
  DEPOSITS
  ACADEMY
  SOP
  EVENTS
  AUTOMATIONS
  TEAM
  SETTINGS
  KNOWLEDGE
  USERS
  OBJECTIVES
}

enum PermissionLevel {
  NONE
  VIEW
  EDIT
  FULL
}

model AppRole {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  color       String   @default("#4f7deb")
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions AppRolePermission[]
  userRoles   AppUserRole[]
}

model AppRolePermission {
  id      String          @id @default(cuid())
  roleId  String
  section AppSection
  level   PermissionLevel @default(NONE)

  role AppRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, section])
}

model AppUserRole {
  id          String   @id @default(cuid())
  clerkUserId String
  roleId      String
  assignedAt  DateTime @default(now())
  assignedBy  String?

  role AppRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([clerkUserId, roleId])
}
