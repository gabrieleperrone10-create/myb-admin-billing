generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

// DATABASE_URL punta al Transaction pooler di Supabase (porta 6543): serve
// alle query dell'app, ma PgBouncer in modalità transazione non supporta i
// lock di sessione che "prisma migrate deploy" richiede (ogni statement puo'
// finire su una connessione fisica diversa) — la migration resta appesa
// all'infinito invece di fallire. DIRECT_URL punta al Session pooler (porta
// 5432, stesso host/credenziali) e la usa solo "prisma migrate deploy".
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProductType {
  SUBSCRIPTION
  COACHING
  CONSULTING
  DIGITAL
}

enum PaymentMethod {
  STRIPE
  PAYPAL
  BANK_TRANSFER
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum CreditNoteStatus {
  ISSUED
  SENT
  CANCELLED
}

enum ContractType {
  RECURRING
  ONE_SHOT
  INSTALLMENT
}

enum BillingPeriod {
  MONTHLY
  QUARTERLY
  ANNUALLY
}

enum DepositStatus {
  PENDING
  PAID
  REFUNDED
}

enum ExpenseCategory {
  TOOLS
  MARKETING
  PAYROLL
  FREELANCER
  INFRASTRUCTURE
  LEGAL
  TRAVEL
  OFFICE
  TAXES
  OTHER
}

enum EventType {
  LIVE
  WORKSHOP
  RECORDING
  WEBINAR
}

enum RecurrenceType {
  ONE_TIME
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

enum RsvpStatus {
  YES
  NO
  MAYBE
}

model Company {
  id     String  @id @default(cuid()) // la riga storica mantiene id = "singleton"
  slug   String  @unique // "market-your-business", "axis-mundi"
  active Boolean @default(true)

  // — identità fiscale (campi ereditati da CompanySettings) —
  // "name" è la ragione sociale: compare su fatture, note di credito e
  // documenti fiscali. "brandName" è il nome mostrato nell'app (sidebar,
  // switcher, titolo pagina) — utile perché più brand possono condividere
  // la stessa ragione sociale ma vanno distinti nell'interfaccia.
  name          String    @default("")
  brandName     String?
  email         String    @default("")
  phone         String?
  website       String?
  address       String?
  city          String?
  zip           String?
  province      String?
  country       String?
  vatNumber     String?
  fiscalCode    String?
  bankName      String?
  iban          String?
  bic           String?
  invoiceFooter String?
  bankBalance   Float?
  bankBalanceAt DateTime?

  // — numerazione documenti —
  invoicePrefix    String @default("INV")
  creditNotePrefix String @default("NC")
  numberPadding    Int    @default(4)

  // — identità email e brand —
  logoUrl          String?
  emailFromName    String?
  emailFromAddress String?
  emailReplyTo     String?
  brandColor       String  @default("#4f7deb")
  locale           String  @default("it-IT")
  defaultCurrency  String  @default("EUR")
  timezone         String  @default("Europe/Rome")

  // — dominio email dell'azienda (Resend, gestito dalla piattaforma) —
  // emailDomain: dominio di INVIO (es. axismundi.it: record DKIM/SPF su
  // sottodomini dedicati, la posta aziendale non viene toccata).
  // inboundDomain: sottodominio di RICEZIONE delle risposte al CRM
  // (es. reply.axismundi.it, record MX solo li'). Unici globalmente: il webhook
  // instrada le risposte anche in base al dominio.
  // Finche' lo stato non e' "verified" si usa il mittente storico
  // (emailFromAddress / EMAIL_FROM) e il dominio di ricezione della piattaforma.
  emailDomain         String? @unique
  emailDomainStatus   String?
  inboundDomain       String? @unique
  inboundDomainStatus String?
  /// { sendingId, receivingId, managedSending, managedReceiving, records: [...], lastCheckedAt, lastError }
  emailDomainMeta     Json?

  // — CRM —
  // Chiave pubblica usata dallo script di tracciamento (t.js) e dagli embed dei
  // form: identifica l'azienda senza esporre id interni. Non e' un segreto.
  trackingKey String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members            CompanyMember[]
  integrations       CompanyIntegration[]
  counters           DocumentCounter[]
  clients            Client[]
  products           Product[]
  contracts          Contract[]
  deposits           Deposit[]
  invoices           Invoice[]
  creditNotes        CreditNote[]
  payments           Payment[]
  expenses           Expense[]
  automations        Automation[]
  sopFolders         SopFolder[]
  sopTags            SopTag[]
  sopSopTags         SopSopTag[]
  sopAttachments     SopAttachment[]
  sops               Sop[]
  tags               Tag[]
  teamMembers        TeamMember[]
  teamMemberTags     TeamMemberTag[]
  courseCategories   CourseCategory[]
  courseCategoryTags CourseCategoryTag[]
  courses            Course[]
  modules            Module[]
  lessons            Lesson[]
  lessonAttachments  LessonAttachment[]
  lessonProgress     LessonProgress[]
  events             Event[]
  eventRsvps         EventRsvp[]
  objectives         Objective[]
  keyResults         KeyResult[]
  checkIns           CheckIn[]
  appRoles           AppRole[]
  appRolePermissions AppRolePermission[]
  appUserRoles       AppUserRole[]

  contacts                Contact[]
  customFieldDefs         CustomFieldDef[]
  crmTags                 CrmTag[]
  contactTags             ContactTag[]
  savedViews              SavedView[]
  notes                   Note[]
  activities              Activity[]
  messages                Message[]
  pipelines               Pipeline[]
  pipelineStages          PipelineStage[]
  opportunities           Opportunity[]
  opportunityStageChanges OpportunityStageChange[]
  forms                   Form[]
  formSubmissions         FormSubmission[]
  pageViews               PageView[]
  calendars               Calendar[]
  availabilities          Availability[]
  appointments            Appointment[]
  calendarConnections     UserCalendarConnection[]
  reminderRules           ReminderRule[]
  notificationLogs        NotificationLog[]
}

model CompanyMember {
  id          String   @id @default(cuid())
  companyId   String
  clerkUserId String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, clerkUserId])
  @@index([clerkUserId])
}

enum IntegrationProvider {
  STRIPE
  PAYPAL
  RESEND
  WHATSAPP
}

/// I segreti NON stanno su Company: quella riga viene passata come prop ai Server
/// Component e ai template PDF, quindi finirebbe serializzata nei payload RSC.
model CompanyIntegration {
  companyId    String
  provider     IntegrationProvider
  publicKey    String?
  secretCipher Bytes?
  secretIv     Bytes?
  secretTag    Bytes?
  meta         Json                @default("{}")
  active       Boolean             @default(false)
  updatedAt    DateTime            @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, provider])
}

enum DocumentKind {
  INVOICE
  CREDIT_NOTE
}

model DocumentCounter {
  companyId String
  kind      DocumentKind
  year      Int
  lastValue Int          @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, kind, year])
}

model Client {
  id         String   @id @default(cuid())
  name       String
  email      String
  phone      String?
  whatsapp   String?
  company    String?
  fiscalCode String?
  vatNumber  String?
  address    String?
  city       String?
  zip        String?
  province   String?
  country    String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  contracts   Contract[]
  invoices    Invoice[]
  creditNotes CreditNote[]

  // Contatto CRM collegato (1:1, opzionale). Client resta l'anagrafica di
  // fatturazione; il CRM lavora su Contact.
  contactId String?  @unique
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  companyId    String
  ownerCompany Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, email])
  @@index([companyId])
  @@index([companyId, createdAt])
}

model Product {
  id          String      @id @default(cuid())
  name        String
  description String?
  type        ProductType
  basePrice   Float
  currency    String      @default("EUR")
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  contracts     Contract[]
  opportunities Opportunity[]

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, active])
}

model Contract {
  id            String        @id @default(cuid())
  clientId      String
  productId     String
  type          ContractType
  amount        Float
  currency      String        @default("EUR")
  startDate     DateTime
  endDate       DateTime?
  billingDay    Int?
  billingPeriod BillingPeriod @default(MONTHLY)
  installments  Int?
  active        Boolean       @default(true)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  client        Client        @relation(fields: [clientId], references: [id])
  product       Product       @relation(fields: [productId], references: [id])
  invoices      Invoice[]
  deposit       Deposit?
  opportunities Opportunity[]

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, active, type])
  @@index([companyId, endDate])
  @@index([companyId, startDate])
  @@index([clientId])
  @@index([productId])
}

model Deposit {
  id         String        @id @default(cuid())
  contractId String        @unique
  amount     Float         @default(500)
  currency   String        @default("EUR")
  status     DepositStatus @default(PENDING)
  paidAt     DateTime?
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  contract Contract @relation(fields: [contractId], references: [id])
  payment  Payment?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, status])
}

model Invoice {
  id         String        @id @default(cuid())
  number     String
  clientId   String
  contractId String?
  amount     Float
  currency   String        @default("EUR")
  status     InvoiceStatus @default(DRAFT)
  issueDate  DateTime      @default(now())
  dueDate    DateTime
  paidAt     DateTime?
  notes      String?
  lineItems  Json
  pdfUrl     String?
  sentAt     DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  client      Client       @relation(fields: [clientId], references: [id])
  contract    Contract?    @relation(fields: [contractId], references: [id])
  payment     Payment?
  creditNotes CreditNote[]

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, number])
  @@index([companyId])
  @@index([companyId, status, dueDate])
  @@index([companyId, issueDate])
  @@index([companyId, contractId])
  @@index([clientId])
}

model CreditNote {
  id     String           @id @default(cuid())
  number String
  status CreditNoteStatus @default(ISSUED)

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id])

  // Snapshot dei dati cliente al momento dell'emissione — valorizzato sia per note
  // collegate a un'Invoice esistente sia per note manuali di fatture non presenti nel gestionale.
  clientName       String
  clientCompany    String?
  clientEmail      String?
  clientVatNumber  String?
  clientFiscalCode String?
  clientAddress    String?
  clientCity       String?
  clientZip        String?
  clientProvince   String?
  clientCountry    String?

  originalInvoiceNumber String
  originalInvoiceDate   DateTime?

  amount    Float
  currency  String    @default("EUR")
  reason    String
  lineItems Json
  issueDate DateTime  @default(now())
  sentAt    DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, number])
  @@index([companyId])
  @@index([companyId, issueDate])
  @@index([invoiceId])
  @@index([clientId])
}

model Payment {
  id              String        @id @default(cuid())
  invoiceId       String?       @unique
  depositId       String?       @unique
  amount          Float
  currency        String        @default("EUR")
  method          PaymentMethod
  stripePaymentId String?
  paypalOrderId   String?
  reference       String?
  paidAt          DateTime      @default(now())
  notes           String?
  createdAt       DateTime      @default(now())

  invoice Invoice? @relation(fields: [invoiceId], references: [id])
  deposit Deposit? @relation(fields: [depositId], references: [id])

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, paidAt])
  @@index([companyId, method, paidAt])
}

model Expense {
  id          String          @id @default(cuid())
  date        DateTime
  category    ExpenseCategory
  description String
  amount      Float
  currency    String          @default("EUR")
  vendor      String?
  receipt     String?
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, date])
  @@index([companyId, category, date])
}

model Automation {
  id        String    @id @default(cuid())
  type      String
  active    Boolean   @default(false)
  config    Json      @default("{}")
  lastRunAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, type])
  @@index([companyId])
}

model SopFolder {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#4f7deb")
  order     Int      @default(0)
  createdAt DateTime @default(now())

  sops Sop[]

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model SopTag {
  id    String      @id @default(cuid())
  name  String
  color String      @default("#4f7deb")
  sops  SopSopTag[]

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId])
}

model SopSopTag {
  sopId String
  tagId String

  sop Sop    @relation(fields: [sopId], references: [id], onDelete: Cascade)
  tag SopTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([sopId, tagId])
  @@index([companyId])
}

model SopAttachment {
  id        String         @id @default(cuid())
  sopId     String
  type      AttachmentType
  name      String
  url       String
  size      Int?
  createdAt DateTime       @default(now())

  sop Sop @relation(fields: [sopId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Sop {
  id        String   @id @default(cuid())
  folderId  String?
  title     String
  content   Json     @default("{}")
  roles     String[]
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  folder      SopFolder?      @relation(fields: [folderId], references: [id])
  tags        SopSopTag[]
  attachments SopAttachment[]

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, folderId])
}

model Tag {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#4f7deb")
  createdAt DateTime @default(now())

  members    TeamMemberTag[]
  categories CourseCategoryTag[]

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId])
}

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  email     String
  role      String?
  avatarUrl String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags     TeamMemberTag[]
  progress LessonProgress[]
  rsvps    EventRsvp[]

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, email])
  @@index([companyId])
}

model TeamMemberTag {
  memberId String
  tagId    String

  member TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  tag    Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([memberId, tagId])
  @@index([companyId])
}

model CourseCategory {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#4f7deb")
  order     Int      @default(0)
  createdAt DateTime @default(now())

  requiredTags CourseCategoryTag[]
  courses      Course[]

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model CourseCategoryTag {
  categoryId String
  tagId      String

  category CourseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tag      Tag            @relation(fields: [tagId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([categoryId, tagId])
  @@index([companyId])
}

model Course {
  id          String   @id @default(cuid())
  categoryId  String
  title       String
  description String?
  coverImage  String?
  published   Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category CourseCategory @relation(fields: [categoryId], references: [id])
  modules  Module[]

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([categoryId])
}

enum AttachmentType {
  LINK
  FILE
}

model Module {
  id        String   @id @default(cuid())
  courseId  String
  parentId  String?
  title     String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  parent   Module?  @relation("ModuleChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children Module[] @relation("ModuleChildren")
  lessons  Lesson[]

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([courseId])
}

model Lesson {
  id        String   @id @default(cuid())
  moduleId  String
  title     String
  videoUrl  String?
  content   String?
  duration  Int?
  order     Int      @default(0)
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  module      Module             @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress    LessonProgress[]
  attachments LessonAttachment[]

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([moduleId])
}

model LessonAttachment {
  id        String         @id @default(cuid())
  lessonId  String
  type      AttachmentType
  name      String
  url       String
  size      Int?
  createdAt DateTime       @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model LessonProgress {
  memberId    String
  lessonId    String
  completedAt DateTime @default(now())

  member TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  lesson Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([memberId, lessonId])
  @@index([companyId])
}

model Event {
  id                 String         @id @default(cuid())
  title              String
  description        String?
  type               EventType
  date               DateTime
  endDate            DateTime?
  location           String?
  meetUrl            String?
  published          Boolean        @default(false)
  recurrence         RecurrenceType @default(ONE_TIME)
  recurrenceInterval Int?
  recurrenceEndDate  DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  rsvps EventRsvp[]

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, date])
}

model EventRsvp {
  memberId String
  eventId  String
  status   RsvpStatus @default(YES)

  member TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  event  Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([memberId, eventId])
  @@index([companyId])
}

// ── Access control ────────────────────────────────────────────────────────────

enum ObjectivePeriod {
  Q1
  Q2
  Q3
  Q4
  ANNUAL
  CUSTOM
  M1
  M2
  M3
  M4
  M5
  M6
  M7
  M8
  M9
  M10
  M11
  M12
}

enum KRType {
  METRIC
  MILESTONE
}

enum KRDataSource {
  INVOICES_AMOUNT
  CLIENT_COUNT
  EXPENSES_AMOUNT
  CONTRACT_COUNT
}

model Objective {
  id          String          @id @default(cuid())
  title       String
  description String?
  emoji       String          @default("🎯")
  color       String          @default("#4f7deb")
  period      ObjectivePeriod
  year        Int
  startDate   DateTime?
  endDate     DateTime?
  ownerId     String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  keyResults KeyResult[]
  checkIns   CheckIn[]

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, year, period])
}

model KeyResult {
  id          String        @id @default(cuid())
  objectiveId String
  title       String
  type        KRType        @default(METRIC)
  target      Float?
  current     Float?        @default(0)
  unit        String?
  dataSource  KRDataSource?
  completed   Boolean       @default(false)
  dueDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  objective Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([objectiveId])
}

model CheckIn {
  id          String   @id @default(cuid())
  objectiveId String
  note        String
  createdAt   DateTime @default(now())

  objective Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([objectiveId])
}

enum AppSection {
  DASHBOARD
  INVOICES
  CREDIT_NOTES
  CLIENTS
  EXPENSES
  CONTRACTS
  PRODUCTS
  PAYMENTS
  DEPOSITS
  ACADEMY
  SOP
  EVENTS
  AUTOMATIONS
  TEAM
  SETTINGS
  KNOWLEDGE
  USERS
  OBJECTIVES
  CONTACTS
  PIPELINES
  CONVERSATIONS
  FORMS
  CALENDARS
}

enum PermissionLevel {
  NONE
  VIEW
  EDIT
  FULL
}

model AppRole {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String   @default("#4f7deb")
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions AppRolePermission[]
  userRoles   AppUserRole[]

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId])
}

model AppRolePermission {
  id      String          @id @default(cuid())
  roleId  String
  section AppSection
  level   PermissionLevel @default(NONE)

  role AppRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([roleId, section])
  @@index([companyId])
}

model AppUserRole {
  id          String   @id @default(cuid())
  clerkUserId String
  roleId      String
  assignedAt  DateTime @default(now())
  assignedBy  String?

  role AppRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, clerkUserId, roleId])
  @@index([companyId])
  @@index([companyId, clerkUserId])
}

// ═══════════════════════════════════════════════════════════════════════════
// CRM
//
// Contact e' il record principale del CRM (lead e clienti). Client resta
// l'anagrafica di fatturazione e punta a un Contact via Client.contactId.
// Come per il resto dello schema, i vincoli di appartenenza alla stessa azienda
// (FK composite su id+companyId) e l'anti-sovrapposizione degli appuntamenti
// vivono solo nelle migration SQL: mai `prisma db push`.
// ═══════════════════════════════════════════════════════════════════════════

enum ContactLifecycle {
  LEAD
  CUSTOMER
  ARCHIVED
}

enum CustomFieldEntity {
  CONTACT
  OPPORTUNITY
}

enum CustomFieldType {
  TEXT
  TEXTAREA
  NUMBER
  DATE
  SELECT
  MULTISELECT
  CHECKBOX
  URL
  EMAIL
  PHONE
}

enum ActivityType {
  CONTACT_CREATED
  CONTACT_UPDATED
  LIFECYCLE_CHANGED
  TAG_ADDED
  TAG_REMOVED
  NOTE_ADDED
  PAGE_VIEW
  FORM_SUBMITTED
  EMAIL_SENT
  EMAIL_RECEIVED
  EMAIL_OPENED
  EMAIL_CLICKED
  EMAIL_BOUNCED
  WHATSAPP_SENT
  WHATSAPP_RECEIVED
  APPOINTMENT_BOOKED
  APPOINTMENT_RESCHEDULED
  APPOINTMENT_CANCELLED
  APPOINTMENT_COMPLETED
  APPOINTMENT_NO_SHOW
  OPPORTUNITY_CREATED
  OPPORTUNITY_STAGE_CHANGED
  OPPORTUNITY_WON
  OPPORTUNITY_LOST
  CLIENT_LINKED
}

enum MessageChannel {
  EMAIL
  WHATSAPP
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  RECEIVED
}

enum StageKind {
  OPEN
  WON
  LOST
}

enum OpportunityStatus {
  OPEN
  WON
  LOST
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentLocation {
  VIDEO
  PHONE
  IN_PERSON
  CUSTOM
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
}

enum NotificationKind {
  CONFIRMATION
  REMINDER
  CANCELLATION
  RESCHEDULE
}

model Contact {
  id          String           @id @default(cuid())
  firstName   String?
  lastName    String?
  email       String? // minuscolo, trim
  phone       String? // E.164 (+39...), vedi lib/crm/contacts.ts normalizePhone
  whatsapp    String? // E.164; se null si usa phone
  companyName String?
  jobTitle    String?
  lifecycle   ContactLifecycle @default(LEAD)
  source      String? // "form:<id>", "booking", "import", "manual", "whatsapp", "email"
  ownerUserId String? // clerkUserId del responsabile

  /// Prima attribuzione: { utm_source, utm_medium, utm_campaign, utm_content, utm_term, fbclid, gclid, referrer, landingUrl, at }
  attribution  Json?
  /// Valori dei campi personalizzati, per `CustomFieldDef.key`
  customFields Json  @default("{}")

  emailOptOut    Boolean @default(false)
  whatsappOptOut Boolean @default(false)

  /// Token per il Reply-To delle email (c-<replyToken>@INBOUND_EMAIL_DOMAIN): le risposte tornano al contatto giusto
  replyToken String @unique @default(cuid())

  lastActivityAt DateTime?
  lastMessageAt  DateTime?
  unreadCount    Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  client          Client?
  tags            ContactTag[]
  notes           Note[]
  activities      Activity[]
  messages        Message[]
  opportunities   Opportunity[]
  formSubmissions FormSubmission[]
  pageViews       PageView[]
  appointments    Appointment[]

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, email])
  @@unique([companyId, phone])
  @@index([companyId])
  @@index([companyId, lifecycle])
  @@index([companyId, createdAt])
  @@index([companyId, lastActivityAt])
  @@index([companyId, lastMessageAt])
  @@index([companyId, ownerUserId])
}

model CustomFieldDef {
  id        String            @id @default(cuid())
  entity    CustomFieldEntity @default(CONTACT)
  key       String // slug stabile, chiave in customFields
  label     String
  type      CustomFieldType
  /// Per SELECT/MULTISELECT: string[]
  options   Json?
  required  Boolean           @default(false)
  order     Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, entity, key])
  @@index([companyId, entity, order])
}

model CrmTag {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#4f7deb")
  createdAt DateTime @default(now())

  contacts ContactTag[]

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId])
}

model ContactTag {
  id        String   @id @default(cuid())
  contactId String
  tagId     String
  createdAt DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     CrmTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([contactId, tagId])
  @@index([companyId])
  @@index([tagId])
}

model SavedView {
  id          String            @id @default(cuid())
  clerkUserId String
  entity      CustomFieldEntity @default(CONTACT)
  name        String
  /// Filtri serializzati (vedi lib/crm/types.ts ContactFilters)
  filters     Json              @default("{}")
  columns     Json              @default("[]")
  sort        Json?
  isShared    Boolean           @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, clerkUserId])
}

model Note {
  id            String   @id @default(cuid())
  contactId     String
  opportunityId String?
  authorUserId  String?
  body          String // HTML (Tiptap)
  pinned        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contact     Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([contactId, createdAt])
}

/// Cronologia unica del contatto. Scritta SOLO tramite lib/crm/activity.ts logActivity().
model Activity {
  id            String       @id @default(cuid())
  contactId     String
  opportunityId String?
  type          ActivityType
  /// Payload tipizzato per `type`, vedi lib/crm/types.ts ActivityData
  data          Json         @default("{}")
  actorUserId   String? // null = sistema/contatto
  occurredAt    DateTime     @default(now())

  contact     Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([contactId, occurredAt(sort: Desc)])
  @@index([companyId, type, occurredAt])
}

model Message {
  id                String           @id @default(cuid())
  contactId         String
  channel           MessageChannel
  direction         MessageDirection
  status            MessageStatus    @default(QUEUED)
  subject           String?
  bodyText          String?
  bodyHtml          String?
  fromAddress       String? // email o numero E.164
  toAddress         String?
  /// id Resend (email) o wamid (WhatsApp)
  providerMessageId String?          @unique
  inReplyTo         String?
  sentByUserId      String?
  attachments       Json?
  error             String?
  deliveredAt       DateTime?
  readAt            DateTime?
  openedAt          DateTime?
  clickedAt         DateTime?
  createdAt         DateTime         @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([contactId, createdAt])
  @@index([companyId, createdAt])
}

model Pipeline {
  id        String   @id @default(cuid())
  name      String
  order     Int      @default(0)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stages        PipelineStage[]
  opportunities Opportunity[]

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model PipelineStage {
  id          String    @id @default(cuid())
  pipelineId  String
  name        String
  order       Int       @default(0)
  kind        StageKind @default(OPEN)
  probability Int? // 0-100
  color       String    @default("#94a3b8")
  createdAt   DateTime  @default(now())

  pipeline      Pipeline                 @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]
  changesFrom   OpportunityStageChange[] @relation("StageChangeFrom")
  changesTo     OpportunityStageChange[] @relation("StageChangeTo")

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([pipelineId, order])
}

model Opportunity {
  id                String            @id @default(cuid())
  name              String
  contactId         String
  pipelineId        String
  stageId           String
  status            OpportunityStatus @default(OPEN)
  value             Float             @default(0)
  currency          String            @default("EUR")
  ownerUserId       String?
  productId         String?
  contractId        String?
  source            String?
  lostReason        String?
  expectedCloseDate DateTime?
  /// Ordinamento dentro la colonna del kanban (frazionario: si inserisce fra due valori)
  position          Float             @default(0)
  customFields      Json              @default("{}")
  stageEnteredAt    DateTime          @default(now())
  closedAt          DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  contact      Contact                  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  pipeline     Pipeline                 @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage        PipelineStage            @relation(fields: [stageId], references: [id], onDelete: Restrict)
  product      Product?                 @relation(fields: [productId], references: [id], onDelete: SetNull)
  contract     Contract?                @relation(fields: [contractId], references: [id], onDelete: SetNull)
  stageChanges OpportunityStageChange[]
  notes        Note[]
  activities   Activity[]
  appointments Appointment[]

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, pipelineId, stageId, position])
  @@index([contactId])
  @@index([companyId, status])
}

model OpportunityStageChange {
  id              String   @id @default(cuid())
  opportunityId   String
  fromStageId     String?
  toStageId       String
  changedByUserId String?
  changedAt       DateTime @default(now())

  opportunity Opportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  fromStage   PipelineStage? @relation("StageChangeFrom", fields: [fromStageId], references: [id], onDelete: SetNull)
  toStage     PipelineStage  @relation("StageChangeTo", fields: [toStageId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([opportunityId, changedAt])
  @@index([companyId, toStageId, changedAt])
}

model Form {
  id        String   @id @default(cuid())
  name      String
  /// FormField[] (vedi lib/crm/types.ts)
  fields    Json     @default("[]")
  /// FormSettings (vedi lib/crm/types.ts)
  settings  Json     @default("{}")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions FormSubmission[]

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model FormSubmission {
  id          String   @id @default(cuid())
  formId      String
  contactId   String?
  data        Json
  attribution Json?
  pageUrl     String?
  visitorId   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  form    Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([formId, createdAt])
  @@index([contactId, createdAt])
}

/// Visite registrate da t.js. contactId si valorizza quando il visitatore si identifica (form, booking).
model PageView {
  id         String   @id @default(cuid())
  visitorId  String
  contactId  String?
  url        String
  path       String?
  title      String?
  referrer   String?
  utm        Json?
  occurredAt DateTime @default(now())

  contact Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, visitorId])
  @@index([companyId, occurredAt])
  @@index([contactId, occurredAt])
}

model Calendar {
  id                  String              @id @default(cuid())
  name                String
  slug                String // URL pubblico: /book/<companySlug>/<slug>
  description         String?
  hostUserId          String // clerkUserId
  durationMinutes     Int                 @default(30)
  slotIntervalMinutes Int                 @default(30)
  bufferMinutes       Int                 @default(0)
  minAdvanceHours     Int                 @default(2)
  maxAdvanceDays      Int                 @default(60)
  locationType        AppointmentLocation @default(VIDEO)
  locationValue       String?
  color               String              @default("#4f7deb")
  timezone            String              @default("Europe/Rome")
  /// Domande extra in prenotazione: FormField[]; e { pipelineId, stageId, tagIds } per creare opportunita'
  settings            Json                @default("{}")
  active              Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  availability Availability[]
  appointments Appointment[]

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, slug])
  @@index([companyId])
}

model Availability {
  id         String @id @default(cuid())
  calendarId String
  dayOfWeek  Int // 0 = domenica ... 6 = sabato
  startTime  String // "HH:mm"
  endTime    String // "HH:mm"

  calendar Calendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([calendarId, dayOfWeek])
}

model Appointment {
  id               String            @id @default(cuid())
  calendarId       String
  contactId        String
  opportunityId    String?
  hostUserId       String
  title            String
  startTime        DateTime
  endTime          DateTime
  status           AppointmentStatus @default(SCHEDULED)
  guestName        String?
  guestEmail       String?
  guestPhone       String?
  notes            String?
  answers          Json?
  googleEventId    String?
  videoLink        String?
  /// Token per annullare/spostare dal link nell'email (mai esposto in lista)
  manageToken      String            @unique @default(cuid())
  rescheduledCount Int               @default(0)
  cancelledAt      DateTime?
  cancelReason     String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  calendar    Calendar          @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  contact     Contact           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  opportunity Opportunity?      @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  logs        NotificationLog[]

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, startTime])
  @@index([hostUserId, startTime])
  @@index([contactId, startTime])
}

model UserCalendarConnection {
  id           String    @id @default(cuid())
  clerkUserId  String
  provider     String    @default("GOOGLE")
  email        String?
  /// refresh token cifrato (lib/crypto.ts)
  secretCipher Bytes
  secretIv     Bytes
  secretTag    Bytes
  connectedAt  DateTime  @default(now())
  lastErrorAt  DateTime?
  lastError    String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, clerkUserId, provider])
  @@index([companyId])
}

model ReminderRule {
  id            String              @id @default(cuid())
  offsetMinutes Int // minuti prima dell'appuntamento
  channel       NotificationChannel @default(EMAIL)
  active        Boolean             @default(true)
  createdAt     DateTime            @default(now())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, offsetMinutes, channel])
  @@index([companyId])
}

/// Idempotenza degli invii: una riga per (appuntamento, tipo, canale, offset).
model NotificationLog {
  id            String              @id @default(cuid())
  appointmentId String
  kind          NotificationKind
  channel       NotificationChannel
  offsetMinutes Int                 @default(0)
  ok            Boolean
  error         String?
  sentAt        DateTime            @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, kind, channel, offsetMinutes])
  @@index([companyId])
}
