generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductType {
  SUBSCRIPTION
  COACHING
  CONSULTING
  DIGITAL
}

enum PaymentMethod {
  STRIPE
  PAYPAL
  BANK_TRANSFER
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum CreditNoteStatus {
  ISSUED
  SENT
  CANCELLED
}

enum ContractType {
  RECURRING
  ONE_SHOT
  INSTALLMENT
}

enum BillingPeriod {
  MONTHLY
  QUARTERLY
  ANNUALLY
}

enum DepositStatus {
  PENDING
  PAID
  REFUNDED
}

enum ExpenseCategory {
  TOOLS
  MARKETING
  PAYROLL
  FREELANCER
  INFRASTRUCTURE
  LEGAL
  TRAVEL
  OFFICE
  TAXES
  OTHER
}

enum EventType {
  LIVE
  WORKSHOP
  RECORDING
  WEBINAR
}

enum RecurrenceType {
  ONE_TIME
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

enum RsvpStatus {
  YES
  NO
  MAYBE
}

model Company {
  id     String  @id @default(cuid()) // la riga storica mantiene id = "singleton"
  slug   String  @unique // "market-your-business", "axis-mundi"
  active Boolean @default(true)

  // — identità fiscale (campi ereditati da CompanySettings) —
  name          String    @default("")
  email         String    @default("")
  phone         String?
  website       String?
  address       String?
  city          String?
  zip           String?
  province      String?
  country       String?
  vatNumber     String?
  fiscalCode    String?
  bankName      String?
  iban          String?
  bic           String?
  invoiceFooter String?
  bankBalance   Float?
  bankBalanceAt DateTime?

  // — numerazione documenti —
  invoicePrefix    String @default("INV")
  creditNotePrefix String @default("NC")
  numberPadding    Int    @default(4)

  // — identità email e brand —
  logoUrl          String?
  emailFromName    String?
  emailFromAddress String?
  emailReplyTo     String?
  brandColor       String  @default("#4f7deb")
  locale           String  @default("it-IT")
  defaultCurrency  String  @default("EUR")
  timezone         String  @default("Europe/Rome")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members            CompanyMember[]
  integrations       CompanyIntegration[]
  counters           DocumentCounter[]
  clients            Client[]
  products           Product[]
  contracts          Contract[]
  deposits           Deposit[]
  invoices           Invoice[]
  creditNotes        CreditNote[]
  payments           Payment[]
  expenses           Expense[]
  automations        Automation[]
  sopFolders         SopFolder[]
  sopTags            SopTag[]
  sopSopTags         SopSopTag[]
  sopAttachments     SopAttachment[]
  sops               Sop[]
  tags               Tag[]
  teamMembers        TeamMember[]
  teamMemberTags     TeamMemberTag[]
  courseCategories   CourseCategory[]
  courseCategoryTags CourseCategoryTag[]
  courses            Course[]
  modules            Module[]
  lessons            Lesson[]
  lessonAttachments  LessonAttachment[]
  lessonProgress     LessonProgress[]
  events             Event[]
  eventRsvps         EventRsvp[]
  objectives         Objective[]
  keyResults         KeyResult[]
  checkIns           CheckIn[]
  appRoles           AppRole[]
  appRolePermissions AppRolePermission[]
  appUserRoles       AppUserRole[]
}

model CompanyMember {
  id          String   @id @default(cuid())
  companyId   String
  clerkUserId String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, clerkUserId])
  @@index([clerkUserId])
}

enum IntegrationProvider {
  STRIPE
  PAYPAL
  RESEND
}

/// I segreti NON stanno su Company: quella riga viene passata come prop ai Server
/// Component e ai template PDF, quindi finirebbe serializzata nei payload RSC.
model CompanyIntegration {
  companyId    String
  provider     IntegrationProvider
  publicKey    String?
  secretCipher Bytes?
  secretIv     Bytes?
  secretTag    Bytes?
  meta         Json                @default("{}")
  active       Boolean             @default(false)
  updatedAt    DateTime            @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, provider])
}

enum DocumentKind {
  INVOICE
  CREDIT_NOTE
}

model DocumentCounter {
  companyId String
  kind      DocumentKind
  year      Int
  lastValue Int          @default(0)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, kind, year])
}

model Client {
  id         String   @id @default(cuid())
  name       String
  email      String
  phone      String?
  whatsapp   String?
  company    String?
  fiscalCode String?
  vatNumber  String?
  address    String?
  city       String?
  zip        String?
  province   String?
  country    String?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  contracts   Contract[]
  invoices    Invoice[]
  creditNotes CreditNote[]

  companyId    String
  ownerCompany Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, email])
  @@index([companyId])
  @@index([companyId, createdAt])
}

model Product {
  id          String      @id @default(cuid())
  name        String
  description String?
  type        ProductType
  basePrice   Float
  currency    String      @default("EUR")
  active      Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  contracts Contract[]

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, active])
}

model Contract {
  id            String        @id @default(cuid())
  clientId      String
  productId     String
  type          ContractType
  amount        Float
  currency      String        @default("EUR")
  startDate     DateTime
  endDate       DateTime?
  billingDay    Int?
  billingPeriod BillingPeriod @default(MONTHLY)
  installments  Int?
  active        Boolean       @default(true)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  client   Client    @relation(fields: [clientId], references: [id])
  product  Product   @relation(fields: [productId], references: [id])
  invoices Invoice[]
  deposit  Deposit?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, active, type])
  @@index([companyId, endDate])
  @@index([companyId, startDate])
  @@index([clientId])
  @@index([productId])
}

model Deposit {
  id         String        @id @default(cuid())
  contractId String        @unique
  amount     Float         @default(500)
  currency   String        @default("EUR")
  status     DepositStatus @default(PENDING)
  paidAt     DateTime?
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  contract Contract @relation(fields: [contractId], references: [id])
  payment  Payment?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, status])
}

model Invoice {
  id         String        @id @default(cuid())
  number     String
  clientId   String
  contractId String?
  amount     Float
  currency   String        @default("EUR")
  status     InvoiceStatus @default(DRAFT)
  issueDate  DateTime      @default(now())
  dueDate    DateTime
  paidAt     DateTime?
  notes      String?
  lineItems  Json
  pdfUrl     String?
  sentAt     DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  client      Client       @relation(fields: [clientId], references: [id])
  contract    Contract?    @relation(fields: [contractId], references: [id])
  payment     Payment?
  creditNotes CreditNote[]

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, number])
  @@index([companyId])
  @@index([companyId, status, dueDate])
  @@index([companyId, issueDate])
  @@index([companyId, contractId])
  @@index([clientId])
}

model CreditNote {
  id     String           @id @default(cuid())
  number String
  status CreditNoteStatus @default(ISSUED)

  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id])
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id])

  // Snapshot dei dati cliente al momento dell'emissione — valorizzato sia per note
  // collegate a un'Invoice esistente sia per note manuali di fatture non presenti nel gestionale.
  clientName       String
  clientCompany    String?
  clientEmail      String?
  clientVatNumber  String?
  clientFiscalCode String?
  clientAddress    String?
  clientCity       String?
  clientZip        String?
  clientProvince   String?
  clientCountry    String?

  originalInvoiceNumber String
  originalInvoiceDate   DateTime?

  amount    Float
  currency  String    @default("EUR")
  reason    String
  lineItems Json
  issueDate DateTime  @default(now())
  sentAt    DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, number])
  @@index([companyId])
  @@index([companyId, issueDate])
  @@index([invoiceId])
  @@index([clientId])
}

model Payment {
  id              String        @id @default(cuid())
  invoiceId       String?       @unique
  depositId       String?       @unique
  amount          Float
  currency        String        @default("EUR")
  method          PaymentMethod
  stripePaymentId String?
  paypalOrderId   String?
  reference       String?
  paidAt          DateTime      @default(now())
  notes           String?
  createdAt       DateTime      @default(now())

  invoice Invoice? @relation(fields: [invoiceId], references: [id])
  deposit Deposit? @relation(fields: [depositId], references: [id])

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, paidAt])
  @@index([companyId, method, paidAt])
}

model Expense {
  id          String          @id @default(cuid())
  date        DateTime
  category    ExpenseCategory
  description String
  amount      Float
  currency    String          @default("EUR")
  vendor      String?
  receipt     String?
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, date])
  @@index([companyId, category, date])
}

model Automation {
  id        String    @id @default(cuid())
  type      String
  active    Boolean   @default(false)
  config    Json      @default("{}")
  lastRunAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, type])
  @@index([companyId])
}

model SopFolder {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#4f7deb")
  order     Int      @default(0)
  createdAt DateTime @default(now())

  sops Sop[]

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model SopTag {
  id    String      @id @default(cuid())
  name  String
  color String      @default("#4f7deb")
  sops  SopSopTag[]

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId])
}

model SopSopTag {
  sopId String
  tagId String

  sop Sop    @relation(fields: [sopId], references: [id], onDelete: Cascade)
  tag SopTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([sopId, tagId])
  @@index([companyId])
}

model SopAttachment {
  id        String         @id @default(cuid())
  sopId     String
  type      AttachmentType
  name      String
  url       String
  size      Int?
  createdAt DateTime       @default(now())

  sop Sop @relation(fields: [sopId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model Sop {
  id        String   @id @default(cuid())
  folderId  String?
  title     String
  content   Json     @default("{}")
  roles     String[]
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  folder      SopFolder?      @relation(fields: [folderId], references: [id])
  tags        SopSopTag[]
  attachments SopAttachment[]

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, folderId])
}

model Tag {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#4f7deb")
  createdAt DateTime @default(now())

  members    TeamMemberTag[]
  categories CourseCategoryTag[]

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId])
}

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  email     String
  role      String?
  avatarUrl String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags     TeamMemberTag[]
  progress LessonProgress[]
  rsvps    EventRsvp[]

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, email])
  @@index([companyId])
}

model TeamMemberTag {
  memberId String
  tagId    String

  member TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  tag    Tag        @relation(fields: [tagId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([memberId, tagId])
  @@index([companyId])
}

model CourseCategory {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#4f7deb")
  order     Int      @default(0)
  createdAt DateTime @default(now())

  requiredTags CourseCategoryTag[]
  courses      Course[]

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model CourseCategoryTag {
  categoryId String
  tagId      String

  category CourseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tag      Tag            @relation(fields: [tagId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([categoryId, tagId])
  @@index([companyId])
}

model Course {
  id          String   @id @default(cuid())
  categoryId  String
  title       String
  description String?
  coverImage  String?
  published   Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category CourseCategory @relation(fields: [categoryId], references: [id])
  modules  Module[]

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([categoryId])
}

enum AttachmentType {
  LINK
  FILE
}

model Module {
  id        String   @id @default(cuid())
  courseId  String
  parentId  String?
  title     String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  course   Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  parent   Module?  @relation("ModuleChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children Module[] @relation("ModuleChildren")
  lessons  Lesson[]

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([courseId])
}

model Lesson {
  id        String   @id @default(cuid())
  moduleId  String
  title     String
  videoUrl  String?
  content   String?
  duration  Int?
  order     Int      @default(0)
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  module      Module             @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress    LessonProgress[]
  attachments LessonAttachment[]

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([moduleId])
}

model LessonAttachment {
  id        String         @id @default(cuid())
  lessonId  String
  type      AttachmentType
  name      String
  url       String
  size      Int?
  createdAt DateTime       @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model LessonProgress {
  memberId    String
  lessonId    String
  completedAt DateTime @default(now())

  member TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  lesson Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([memberId, lessonId])
  @@index([companyId])
}

model Event {
  id                 String         @id @default(cuid())
  title              String
  description        String?
  type               EventType
  date               DateTime
  endDate            DateTime?
  location           String?
  meetUrl            String?
  published          Boolean        @default(false)
  recurrence         RecurrenceType @default(ONE_TIME)
  recurrenceInterval Int?
  recurrenceEndDate  DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  rsvps EventRsvp[]

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, date])
}

model EventRsvp {
  memberId String
  eventId  String
  status   RsvpStatus @default(YES)

  member TeamMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  event  Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([memberId, eventId])
  @@index([companyId])
}

// ── Access control ────────────────────────────────────────────────────────────

enum ObjectivePeriod {
  Q1
  Q2
  Q3
  Q4
  ANNUAL
  CUSTOM
  M1
  M2
  M3
  M4
  M5
  M6
  M7
  M8
  M9
  M10
  M11
  M12
}

enum KRType {
  METRIC
  MILESTONE
}

enum KRDataSource {
  INVOICES_AMOUNT
  CLIENT_COUNT
  EXPENSES_AMOUNT
  CONTRACT_COUNT
}

model Objective {
  id          String          @id @default(cuid())
  title       String
  description String?
  emoji       String          @default("🎯")
  color       String          @default("#4f7deb")
  period      ObjectivePeriod
  year        Int
  startDate   DateTime?
  endDate     DateTime?
  ownerId     String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  keyResults KeyResult[]
  checkIns   CheckIn[]

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, year, period])
}

model KeyResult {
  id          String        @id @default(cuid())
  objectiveId String
  title       String
  type        KRType        @default(METRIC)
  target      Float?
  current     Float?        @default(0)
  unit        String?
  dataSource  KRDataSource?
  completed   Boolean       @default(false)
  dueDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  objective Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([objectiveId])
}

model CheckIn {
  id          String   @id @default(cuid())
  objectiveId String
  note        String
  createdAt   DateTime @default(now())

  objective Objective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([objectiveId])
}

enum AppSection {
  DASHBOARD
  INVOICES
  CREDIT_NOTES
  CLIENTS
  EXPENSES
  CONTRACTS
  PRODUCTS
  PAYMENTS
  DEPOSITS
  ACADEMY
  SOP
  EVENTS
  AUTOMATIONS
  TEAM
  SETTINGS
  KNOWLEDGE
  USERS
  OBJECTIVES
}

enum PermissionLevel {
  NONE
  VIEW
  EDIT
  FULL
}

model AppRole {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String   @default("#4f7deb")
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions AppRolePermission[]
  userRoles   AppUserRole[]

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId])
}

model AppRolePermission {
  id      String          @id @default(cuid())
  roleId  String
  section AppSection
  level   PermissionLevel @default(NONE)

  role AppRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([roleId, section])
  @@index([companyId])
}

model AppUserRole {
  id          String   @id @default(cuid())
  clerkUserId String
  roleId      String
  assignedAt  DateTime @default(now())
  assignedBy  String?

  role AppRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, clerkUserId, roleId])
  @@index([companyId])
  @@index([companyId, clerkUserId])
}
